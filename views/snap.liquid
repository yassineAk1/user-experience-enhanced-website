{% render 'views/head.liquid' %}

<header>
  <nav class="header-nav">
    {% comment %} <span class="map-title-btn">{{ snap.snapmap.name }}</span> {% endcomment %}
  </nav>
</header>

<main class="snap-detail">
  <div class="snap-detail-photo">
    <picture>
      <source
        type="image/webp"
        srcset="https://fdnd-agency.directus.app/assets/{{ snap.picture.id }}?format=webp&width=400"
      >
      <img
        src="https://fdnd-agency.directus.app/assets/{{ snap.picture.id }}?width=400"
        alt="{{ snap.author.name }}"
        fetchpriority="high"
        style="view-transition-name: snap-{{ snap.uuid }}"
      >
    </picture>
  </div>

<div class="snap-detail-info">
  <div class="snap-tags">
    <a href="/snapmap/{{ snap.snapmap.uuid }}" class="snap-tag">{{ snap.snapmap.name }}</a>
    <a href="#" class="snap-tag">{{ snap.author.name }}</a>
    <a href="#" class="snap-tag">{{ snap.location }}</a>
    <time datetime="{{ snap.date_created }}">{{ snap.date_created | date: '%d %B %Y %H:%M' }}</time>
  </div>
</div>

</main>

{% render 'views/foot.liquid', activePage: activePage %}
